# BELL environment variables
# Copy this file to .env and fill in the values.

# ── Fork deployment ──────────────────────────────────────────────────
# RPC endpoint for chain 4663 (Robinhood Chain). Required for `make deploy-fork`.
# BELL_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Private key for the deployer account. Required for `make deploy-fork`.
# BELL_DEPLOYER_KEY=0x...

# ── Contract deployment overrides ────────────────────────────────────
# The reference collateral token address. Required on a fork; a dev
# collateral is deployed when unset.
# BELL_COLLATERAL=0x7fa9385be102ac3eac297483dd6233d62b3e1496

# The dispute arbiter. Defaults to the broadcaster.
# BELL_ARBITER=0x...

# The session counter and fallback authority. Defaults to the broadcaster.
# BELL_SESSION_AUTHORITY=0x...

# Optional; when set, a session is listed for this reference token.
# BELL_REFERENCE_TOKEN=0x2e234DAe75C793f67A35089C9d99245E1C58470b

# ── Web app (live mode) ─────────────────────────────────────────────
# Set BELL_RPC_URL to enable live mode (default: replay from fixtures).
# Also requires the three contract addresses:
# BELL_FACTORY=0x5615dEB798BB3E4dFa0139dFa1b3D433Cc23b72f
# BELL_REGISTRY=0xF62849F9A0B5Bf2913b396098F7c7019b51A820a
# BELL_PREMIUM=0x5991A2dF15A8F6A256D3Ec51E99254Cd3fb576A9

# ── Challenge verification ───────────────────────────────────────────
# HTTP committed-input store URL. When set, challenge re-fits fetch
# windows by inputsHash from this endpoint instead of the file store.
# BELL_INPUT_STORE_URL=http://localhost:8080
